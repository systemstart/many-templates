{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "schedule": [
    "before 9am on monday"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "commitMessagePrefix": "fix(deps):"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "commitMessagePrefix": "ci(deps):"
    },
    {
      "description": "These actions tag their releases vN only, with no vN.N.N. helpers:pinGitHubActionDigestsToSemver extracts vN.N.N tags only, so it would find no versions for them; take vN here.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "cachix/cachix-action",
        "DeterminateSystems/nix-installer-action",
        "DeterminateSystems/magic-nix-cache-action"
      ],
      "extractVersion": "^(?<version>v\\d+)$"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.yml$/"
      ],
      "matchStrings": [
        "GSEMVER_VERSION:\\s*\"(?<currentValue>.*?)\""
      ],
      "depNameTemplate": "arnaud-deprez/gsemver",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "go.mod"
      ],
      "matchStrings": [
        "\\ngo (?<currentValue>[^\\s]+)\\n"
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    }
  ]
}
